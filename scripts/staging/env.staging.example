# Copy to .env.staging in the project root (git-ignored). Used by: npm run dev:staging
# Every key the app uses is listed so nothing silently falls back to production values from .env.local.

# --- Pre-production Supabase project (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://STAGINGREF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3001

# --- Razorpay TEST mode keys (Dashboard → switch to Test Mode → API Keys); never live keys here ---
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_WEBHOOK_SECRET=

# --- Sandbox.co.in TEST keys (GST: E-Way Bill / E-Invoice) ---
SANDBOX_API_KEY=
SANDBOX_API_SECRET=
SANDBOX_BASE_URL=https://test-api.sandbox.co.in
SANDBOX_ENV=sandbox
SANDBOX_USERNAME=
SANDBOX_PASSWORD=

# --- Email (can reuse production Resend key; emails really get sent) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
