# Copy to .env.db in the project root (it is git-ignored). Never commit real values.
# Supabase dashboard → your project → Connect → "Session pooler" → URI. Put your DB password in place of [YOUR-PASSWORD].
PROD_DB_URL=postgresql://postgres.PRODREF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres
STAGING_DB_URL=postgresql://postgres.STAGINGREF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres
