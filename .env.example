# Copy to .env.local (local) and set the same keys in your hosting provider (production).
# Every key the code reads is listed here. Never commit real values.

# --- Supabase (Project Settings → API → Legacy API keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # public "anon" key
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # secret "service_role" key — server only

# Public site address (used in invite links), e.g. https://www.shopos.co.in
NEXT_PUBLIC_APP_URL=

# --- Email (Resend) — sign-up codes, password reset, invoices ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=info@yourdomain.com

# --- Razorpay — subscription payments (rzp_test_... for testing, rzp_live_... in production) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=                    # same value as RAZORPAY_KEY_ID

# --- Sandbox.co.in (Quicko) — E-Way Bill & E-Invoice ---
SANDBOX_API_KEY=
SANDBOX_API_SECRET=
SANDBOX_BASE_URL=https://api.sandbox.co.in      # https://test-api.sandbox.co.in with test keys
SANDBOX_ENV=production

# --- Gemini — only for the in-app support assistant (firms enter their own key for scanning) ---
GEMINI_API_KEY=

# --- Twilio WhatsApp — optional, invoice delivery ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=+14155238886

# --- Admin panel access (comma-separated emails) ---
ADMIN_EMAILS=you@example.com
